<?xml version="1.0" encoding="utf-8"?>
<project source="2.7.1" version="1.0">

  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>

  <main name="main"/>

  <options>
    <a name="gateUndefined" val="error"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>

  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
  </toolbar>


  <circuit name="main">

    <!-- Day/Night Sensor -->
    <comp lib="0" name="Pin" loc="(80,100)">
      <a name="facing" val="east"/>
      <a name="label" val="DAY_SENSOR"/>
    </comp>


    <!-- Motion Sensor -->
    <comp lib="0" name="Pin" loc="(80,180)">
      <a name="facing" val="east"/>
      <a name="label" val="MOTION_SENSOR"/>
    </comp>


    <!-- Enable Switch -->
    <comp lib="0" name="Pin" loc="(80,260)">
      <a name="facing" val="east"/>
      <a name="label" val="SYSTEM_ENABLE"/>
    </comp>


    <!-- NOT Gate for Day Sensor -->
    <comp lib="1" name="NOT Gate" loc="(220,100)">
      <a name="facing" val="east"/>
    </comp>


    <!-- OR Gate -->
    <comp lib="1" name="OR Gate" loc="(370,130)">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
    </comp>


    <!-- AND Gate -->
    <comp lib="1" name="AND Gate" loc="(520,150)">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
    </comp>


    <!-- Output -->
    <comp lib="0" name="Pin" loc="(650,150)">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="STREET_LIGHT"/>
    </comp>


    <!-- LED -->
    <comp lib="5" name="LED" loc="(600,240)">
      <a name="label" val="STREET_LIGHT_LED"/>
    </comp>



    <!-- Connections -->

    <!-- Day sensor to NOT -->
    <wire from="(80,100)" to="(190,100)"/>

    <!-- NOT output to OR -->
    <wire from="(220,100)" to="(330,100)"/>


    <!-- Motion sensor to OR -->
    <wire from="(80,180)" to="(280,180)"/>
    <wire from="(280,180)" to="(280,150)"/>
    <wire from="(280,150)" to="(330,150)"/>


    <!-- OR output to AND -->
    <wire from="(370,130)" to="(470,130)"/>


    <!-- Enable to AND -->
    <wire from="(80,260)" to="(430,260)"/>
    <wire from="(430,260)" to="(430,170)"/>
    <wire from="(430,170)" to="(470,170)"/>


    <!-- AND output -->
    <wire from="(520,150)" to="(650,150)"/>


    <!-- LED connection -->
    <wire from="(600,150)" to="(600,240)"/>


  </circuit>

</project>
