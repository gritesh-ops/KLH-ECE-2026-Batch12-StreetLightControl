<?xml version="1.0" encoding="utf-8"?>
<project source="2.7.1" version="1.0">

  <lib desc="#Wiring" name="0"/>
  <lib desc="#Gates" name="1"/>
  <lib desc="#Plexers" name="2"/>
  <lib desc="#Arithmetic" name="3"/>
  <lib desc="#Memory" name="4"/>
  <lib desc="#I/O" name="5"/>
  <lib desc="#Base" name="6"/>

  <main name="main"/>

  <options>
    <a name="gateUndefined" val="error"/>
    <a name="simlimit" val="1000"/>
    <a name="simrand" val="0"/>
  </options>

  <toolbar>
    <tool lib="6" name="Poke Tool"/>
    <tool lib="6" name="Edit Tool"/>
  </toolbar>

  <circuit name="main">

    <!-- Daylight Sensor: D -->
    <comp lib="0" name="Pin" loc="(80,100)">
      <a name="facing" val="east"/>
      <a name="label" val="D_DAYLIGHT"/>
    </comp>

    <!-- Manual Override: M -->
    <comp lib="0" name="Pin" loc="(80,180)">
      <a name="facing" val="east"/>
      <a name="label" val="M_MANUAL_OVERRIDE"/>
    </comp>

    <!-- System Enable: E -->
    <comp lib="0" name="Pin" loc="(80,260)">
      <a name="facing" val="east"/>
      <a name="label" val="E_SYSTEM_ENABLE"/>
    </comp>

    <!-- NOT Gate: D' -->
    <comp lib="1" name="NOT Gate" loc="(220,100)">
      <a name="facing" val="east"/>
    </comp>

    <!-- OR Gate: D' + M -->
    <comp lib="1" name="OR Gate" loc="(370,140)">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
    </comp>

    <!-- AND Gate: E(D' + M) -->
    <comp lib="1" name="AND Gate" loc="(520,160)">
      <a name="facing" val="east"/>
      <a name="inputs" val="2"/>
    </comp>

    <!-- Street Light Output -->
    <comp lib="0" name="Pin" loc="(650,160)">
      <a name="facing" val="west"/>
      <a name="output" val="true"/>
      <a name="label" val="L_STREET_LIGHT"/>
    </comp>

    <!-- LED -->
    <comp lib="5" name="LED" loc="(600,240)">
      <a name="label" val="STREET_LIGHT_LED"/>
    </comp>

    <!-- D -> NOT -->
    <wire from="(80,100)" to="(190,100)"/>

    <!-- NOT(D) -> OR input 1 -->
    <wire from="(250,100)" to="(300,100)"/>
    <wire from="(300,100)" to="(300,130)"/>
    <wire from="(300,130)" to="(350,130)"/>

    <!-- M -> OR input 2 -->
    <wire from="(80,180)" to="(300,180)"/>
    <wire from="(300,180)" to="(300,150)"/>
    <wire from="(300,150)" to="(350,150)"/>

    <!-- OR -> AND input 1 -->
    <wire from="(390,140)" to="(470,140)"/>

    <!-- E -> AND input 2 -->
    <wire from="(80,260)" to="(430,260)"/>
    <wire from="(430,260)" to="(430,180)"/>
    <wire from="(430,180)" to="(470,180)"/>

    <!-- AND -> Street Light Output -->
    <wire from="(540,160)" to="(650,160)"/>

    <!-- AND -> LED -->
    <wire from="(540,160)" to="(600,160)"/>
    <wire from="(600,160)" to="(600,220)"/>

  </circuit>

</project>
